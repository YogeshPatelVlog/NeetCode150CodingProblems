// first we can add whole linked list to Intger Arraylist and now traverse whole list and add values to .add and now do two pointer approach to get Index element and chech values 

class Solution {
    public boolean isPalindrome(ListNode head) {
        List<Integer> list = new ArrayList<>();
        while(head != null){
            list.add(head.val);
            head = head.next;
        }

        int left = 0; 
        int right = list.size()-1;
        while(left< right){
            if(!list.get(left).equals(list.get(right))){
                return false;
            }
            left++;
            right--;
        }
        return true;
    }
}
